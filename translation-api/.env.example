# Translation API Service
PORT=5000
DATABASE_URL=postgresql://mmuser:mmuser_password@localhost:5432/ugajapa_api
JWT_SECRET=your-very-long-random-secret-here-change-in-production
BOT_URL=http://localhost:8000

# Translation engines
GROQ_API_KEY=
GOOGLE_API_KEY=

# Translation result cache (in-memory, keyed by origin text + from + to)
# Set TTL to 0 to disable. Default: 3600 (1 hour).
TRANSLATION_CACHE_TTL_SECONDS=3600
TRANSLATION_CACHE_MAX_ENTRIES=10000
# Language detection cache (same TTL semantics; reduces Google detect calls)
DETECT_CACHE_TTL_SECONDS=3600
# Back-translation doubles engine calls — off by default (quality uses AI review)
BACK_TRANSLATION_ENABLED=false
GOOGLE_SPEECH_API_KEY=
GOOGLE_TTS_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Translation quality review (AI semantic evaluation via Groq)
# Uses GROQ_API_KEY. Set QUALITY_EVAL_DISABLED=true to use heuristic fallback only.
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile
QUALITY_PASS_THRESHOLD=0.7

# Billing cron
BILLING_CRON_SECRET=another-random-secret

# Optional seed admin (used by db-init / docker entry)
ADMIN_EMAIL=admin@ugajapa.ac.ug
ADMIN_PASSWORD=ChangeMeAdmin123!
