# Root environment — shared by docker-compose
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser_password
POSTGRES_DB=ugajapa_api

JWT_SECRET=your-very-long-random-secret-here-change-in-production
BILLING_CRON_SECRET=another-random-secret

GROQ_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SPEECH_API_KEY=
GOOGLE_TTS_API_KEY=

ADMIN_EMAIL=admin@ugajapa.ac.ug
ADMIN_PASSWORD=ChangeMeAdmin123!

# Host-side ports — only needed if the defaults conflict with something
# else already running on this machine. Container-internal ports (5432,
# 8000, 5000) never change; only which host port they're mapped to does.
# POSTGRES_PORT=5434
# BOT_PORT=8000
# API_PORT=5000
