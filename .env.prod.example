# UgaJapa Translation API — PRODUCTION secrets template
#
# Copy this file to .env.prod (same directory as docker-compose.prod.yml)
# and fill in real values. .env.prod is gitignored — never commit it.
#
#   cp .env.prod.example .env.prod

# --- Postgres ---
# Used both to initialize the postgres container itself and to build the
# DATABASE_URL below — keep these three consistent with the URL.
POSTGRES_USER=ugajapa_prod
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=ugajapa_api

# Must match the three values above. "postgres" is the service name on the
# compose network, not a placeholder — leave it as-is.
DATABASE_URL=postgresql://ugajapa_prod:CHANGE_ME_use_a_long_random_password@postgres:5432/ugajapa_api

# --- Core secrets ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_string
BILLING_CRON_SECRET=CHANGE_ME_long_random_string

# --- Translation engines ---
# At least one recommended — UgaJapa Bot (NLLB-200, always included in this
# stack) is the last-resort fallback if both are unset, but quality and
# language coverage are much better with these configured.
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Email delivery (signup verification codes) — set at least one ---
# Gmail SMTP is tried first, then Resend. If your server's outbound SMTP
# is blocked (some cloud/PaaS hosts block it — a real VPS usually doesn't),
# Resend still works since it's a plain HTTPS API call.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
# RESEND_FROM_EMAIL=UgaJapa Connect <noreply@yourdomain.com>   # once a domain is verified at resend.com/domains

# Resend's sandbox mode (no verified domain) can only deliver to the
# account owner's own address. Setting this routes every verification code
# there instead of to each signer's own email, for manual relay — remove
# once a domain is verified, or leave unset if you don't need it.
# VERIFICATION_RELAY_EMAIL=

# --- Admin seed account ---
# Created automatically on first boot if it doesn't already exist.
ADMIN_EMAIL=admin@ugajapa.ac.ug
ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- Ports ---
# Host-side port for the public API (behind your reverse proxy). Only
# matters if 5000 is already taken by something else on this server — the
# container's internal port doesn't change either way.
# API_PORT=5000
